# Copy ไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรง
# cp .env.example .env

SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-another-random-secret

# PostgreSQL
# กรณี postgres อยู่ใน docker-compose stack นี้:
#   DB_HOST=postgres
# กรณี postgres รันบน Pi โดยตรง (นอก Docker):
#   DB_HOST=host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=iot208
DB_USER=iot208
DB_PASSWORD=strongpassword

# CORS — ใส่ IP ของ Raspberry Pi
CORS_ORIGINS=http://192.168.1.x:3000,http://localhost:3000

# MQTT — external broker (WebSocket)
MQTT_BROKER=mqtt.baan208-iot.biz
MQTT_PORT=80
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# Rain Sensor Device ID (UUID จาก device_profiles)
RAIN_SENSOR_DEVICE_ID=dae88ae3-784a-45e9-be9d-0b52b9d03f56
